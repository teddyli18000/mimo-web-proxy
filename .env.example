# MiMo Web Proxy 环境变量（可选，优先级高于 config.json）
# 注意：本项目不会自动加载 .env 文件，需要你自己在启动前设置好环境变量
# Windows: set PORT=8080 或 PowerShell: $env:PORT="8080"

# 监听端口（覆盖 config.json 的 port）
PORT=8080

# API Key（覆盖 config.json 的 api_key）
API_KEY=sk-mimo

# 配置文件路径（默认与 exe 同目录的 config.json）
CONFIG_PATH=config.json

# 设为 1 禁止启动时自动打开浏览器面板
# NO_BROWSER_OPEN=1
